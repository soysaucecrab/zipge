{
	"name": "zipge",
	"version": "0.1.3",
	"description": "집게(zipge) — 정적 사이트에 AI 검색을 붙여주는 엔진. 서버·API 비용 0: 한국어 시맨틱 검색(37MB 가지치기 e5)·형태소 매칭·오타 교정이 브라우저에서 완결",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./worker": "./dist/embed-worker.js",
		"./src/*": "./src/*"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit"
	},
	"keywords": [
		"zipge",
		"search",
		"korean",
		"static-site",
		"static-site-search",
		"ai-search",
		"semantic-search",
		"transformers.js",
		"wasm",
		"on-device",
		"typo-correction",
		"morphological-analysis"
	],
	"author": "KIM ZINU (soysaucecrab)",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/soysaucecrab/zipge.git"
	},
	"peerDependencies": {
		"@huggingface/transformers": ">=3",
		"garu-ko": ">=0.1"
	},
	"peerDependenciesMeta": {
		"garu-ko": {
			"optional": true
		}
	},
	"devDependencies": {
		"@huggingface/transformers": "^3.8.0",
		"garu-ko": "^0.5.0",
		"typescript": "^5.9.0"
	}
}
